module Datapath (
    input  wire        clk,
    input  wire        rst_n,
    input  wire [31:0] Instruction // Đầu vào mô phỏng tập lệnh từ bộ nhớ lệnh
);

    // --- 1. Tách các trường (fields) của lệnh ---
    wire [5:0]  opcode = Instruction[31:26];
    wire [4:0]  rs     = Instruction[25:21];
    wire [4:0]  rt     = Instruction[20:16];
    wire [4:0]  rd     = Instruction[15:11];
    wire [15:0] imm    = Instruction[15:0];

    // --- 2. Kết nối Control Unit ---
    wire RegDst, ALUSrc, MemToReg, RegWrite, MemRead, MemWrite;
    wire [1:0] ALUOp;
    
    Control_Unit cu (
        .Opcode(opcode),
        .RegDst(RegDst), .ALUSrc(ALUSrc), .MemToReg(MemToReg),
        .RegWrite(RegWrite), .MemRead(MemRead), .MemWrite(MemWrite),
        .ALUOp(ALUOp)
    );

    // --- 3. Kết nối ALU Control ---
    wire [3:0] ALUcontrol;
    ALU_Control alu_ctrl (
        .ALUOp(ALUOp),
        .ALUcontrol(ALUcontrol)
    );

    // --- 4. Cấu hình Mux cho thanh ghi cần ghi & Register File ---
    wire [4:0] WriteRegister = (RegDst) ? rd : rt;
    wire [31:0] WriteDataReg; // Dữ liệu sẽ ghi vào RegisterFile
    wire [31:0] ReadData1, ReadData2;

    RegisterFile rf (
        .clk(clk), .rst_n(rst_n),
        .ReadAddress1(rs), .ReadAddress2(rt), .WriteAddress(WriteRegister),
        .WriteData(WriteDataReg), .WriteEn(RegWrite),
        .ReadData1(ReadData1), .ReadData2(ReadData2)
    );

    // --- 5. Cấu hình Sign Extend & Mux cho đầu vào ALU ---
    wire [31:0] SignExtImm = {{16{imm[15]}}, imm}; // Mở rộng dấu 16 bit lên 32 bit
    wire [31:0] ALU_InB    = (ALUSrc) ? SignExtImm : ReadData2;

    // --- 6. ALU 32-bit ---
    wire [31:0] ALU_Result;
    wire Overflow;
    // ALU của bạn lấy 3 bit {M, S1, S0}. Ta trích 3 bit thấp của ALUcontrol (0101 -> 101)
    ALU_32bit alu (
        .A(ReadData1), .B(ALU_InB),
        .M(ALUcontrol[2]), .S1(ALUcontrol[1]), .S0(ALUcontrol[0]), 
        .Out(ALU_Result), .Overflow(Overflow)
    );

    // --- 7. Bộ nhớ Dữ liệu (Dual Port RAM) ---
    wire [7:0] ReadDataMem_8bit;
    Dual_Port_Ram dmem (
        .clk(clk),
        .Address(ALU_Result[9:0]),      // Address 10-bit từ ALU
        .WriteData(ReadData2[7:0]),     // Lưu 8-bit thấp vào RAM (theo module của bạn)
        .WriteEn(MemWrite),
        .ReadEn(MemRead),
        .ReadData(ReadDataMem_8bit)
    );

    // --- 8. Mux quyết định dữ liệu Write Back về Reg ---
    wire [31:0] ReadDataMem_32bit = {24'b0, ReadDataMem_8bit}; // Zero-extend về 32 bit
    assign WriteDataReg = (MemToReg) ? ReadDataMem_32bit : ALU_Result;

endmodule