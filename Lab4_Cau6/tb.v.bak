`timescale 1ns/1ps

module tb;

    // DUT inputs
    reg KEY0; // OE_N
    reg KEY1; // WE_N
    reg [15:0] SW;

    // DUT outputs
    wire [6:0] HEX0, HEX1, HEX2, HEX3;

    // SRAM signals
    wire [15:0] SRAM_DQ;
    wire [17:0] SRAM_ADDR;
    wire SRAM_CE_N, SRAM_OE_N, SRAM_WE_N;
    wire SRAM_LB_N, SRAM_UB_N;

    // =========================
    // Instantiate DUT
    // =========================
    sram_interface dut (
        .KEY0(KEY0),
        .KEY1(KEY1),
        .SW(SW),
        .HEX0(HEX0),
        .HEX1(HEX1),
        .HEX2(HEX2),
        .HEX3(HEX3),

        .SRAM_DQ(SRAM_DQ),
        .SRAM_ADDR(SRAM_ADDR),
        .SRAM_CE_N(SRAM_CE_N),
        .SRAM_OE_N(SRAM_OE_N),
        .SRAM_WE_N(SRAM_WE_N),
        .SRAM_LB_N(SRAM_LB_N),
        .SRAM_UB_N(SRAM_UB_N)
    );

    // =========================
    // SRAM model
    // =========================
    my_sram mem (
        .CE_N(SRAM_CE_N),
        .OE_N(SRAM_OE_N),
        .WE_N(SRAM_WE_N),
        .ADDR(SRAM_ADDR),
        .DQ(SRAM_DQ)
    );

    // =========================
    // Expected value
    // =========================
    reg [15:0] expected;

    // =========================
    // TEST
    // =========================
    initial begin
        // init
        KEY0 = 1; // OE off
        KEY1 = 1; // WE off
        SW   = 0;

        #10;

        // =====================
        // WRITE
        // =====================
        SW[15:8] = 8'h01;   // address
        SW[7:0]  = 8'hAB;   // data
        expected = 16'h00AB;

        KEY1 = 0; // WE active

        #20;      // >= tWE

        KEY1 = 1; // stop write

        // =====================
        // READ
        // =====================
        #10;

        KEY0 = 0; // OE active

        #20;      // >= tACC

        // =====================
        // SELF CHECK
        // =====================
        if (SRAM_DQ !== expected) begin
            $display("FAIL: expected=%h got=%h time=%0t",
                     expected, SRAM_DQ, $time);
        end else begin
            $display("PASS: %h time=%0t", SRAM_DQ, $time);
        end

        KEY0 = 1;

        // =====================
        // TEST 2
        // =====================
        #20;

        SW[15:8] = 8'h02;
        SW[7:0]  = 8'h55;
        expected = 16'h0055;

        KEY1 = 0;

        #20;

        KEY1 = 1;

        #10;

        KEY0 = 0;

        #20;

        if (SRAM_DQ !== expected) begin
            $display("❌ FAIL: expected=%h got=%h time=%0t",
                     expected, SRAM_DQ, $time);
        end else begin
            $display("✅ PASS: %h time=%0t", SRAM_DQ, $time);
        end

        KEY0 = 1;

        #50;
        $display("==== DONE ====");
        $stop;
    end

endmodule