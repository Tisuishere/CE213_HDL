module pulse_05s (
    input wire CLOCK_50,
    input wire rst_n,      // Nên có chân reset
    output reg pulse_05s
);
    // 25,000,000 cần 25 bit (2^25 = 33,554,432)
    reg [24:0] count;

    always @(posedge CLOCK_50 or negedge rst_n) begin
        if (!rst_n) begin
            count <= 25'd0;
            pulse_05s <= 1'b0;
        end
        else begin
            // Đếm từ 0 đến 24,999,999 (đủ 25 triệu chu kỳ)
            if (count == 25'd24_999_999) begin
                count <= 25'd0;
                pulse_05s <= 1'b1; // Tạo xung cao trong 1 chu kỳ clock
            end
            else begin
                count <= count + 1'b1;
                pulse_05s <= 1'b0;
            end
        end
    end
endmodule